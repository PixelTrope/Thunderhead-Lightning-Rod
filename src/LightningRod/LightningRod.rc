#include <windows.h>
#include "resource.h"
#include "../common/Version.h"

IDI_LR_APP ICON "LightningRod.ico"

IDR_LR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit", IDM_LR_EXIT
    END
    POPUP "&Control"
    BEGIN
        MENUITEM "&Settings", IDM_LR_SETTINGS
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Lightning Rod", IDM_LR_ABOUT
    END
END

// MS Shell Dlg maps to the dialog font of every Windows from XP on.
IDD_LR_SETTINGS DIALOGEX 0, 0, 270, 312
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Lightning Rod Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    AUTOCHECKBOX    "Act as SMB1 Relay", IDC_RELAY_CHECK, 10, 10, 250, 10
    LTEXT           "Relay to this Windows XP client (IP address):", -1, 24, 28, 236, 10
    EDITTEXT        IDC_RELAY_IP, 24, 40, 110, 13, ES_AUTOHSCROLL | WS_DISABLED
    LTEXT           "", IDC_RELAY_INFO, 10, 60, 250, 34
    LTEXT           "Bryce 3D Network Render Host (B3NDHR) mode:", IDC_RENDERHOST_LABEL, 10, 104, 170, 10
    CONTROL         "", IDC_RENDERHOST_SWITCH, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 184, 101, 30, 14
    LTEXT           "Off", IDC_RENDERHOST_STATE, 220, 104, 40, 10
    LTEXT           "This node runs the full Bryce 3D and hands the frames out; Thunderhead tints its row and treats it as the host. Kept for the next start.", -1, 10, 118, 250, 18
    LTEXT           "RENDER.BIN folder, where the host writes the frames:", IDC_RENDERBIN_LABEL, 10, 140, 250, 10
    EDITTEXT        IDC_RENDERBIN_PATH, 10, 152, 250, 13, ES_AUTOHSCROLL
    LTEXT           "", IDC_RENDERBIN_NOTE, 10, 167, 250, 10
    LTEXT           "", IDC_NET_INFO, 10, 181, 250, 34
    CONTROL         "", IDC_NET_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 10, 217, 250, 54
    LTEXT           "Preferred adapter:", -1, 10, 278, 64, 10
    COMBOBOX        IDC_NET_PREFERRED, 76, 276, 184, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 156, 294, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 210, 294, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     TLR_VERSION_MAJOR, TLR_VERSION_MINOR, TLR_VERSION_PATCH, 0
PRODUCTVERSION  TLR_VERSION_MAJOR, TLR_VERSION_MINOR, TLR_VERSION_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Lightning Rod render node agent"
            VALUE "FileVersion", TLR_VERSION_STRING
            VALUE "InternalName", "LightningRod"
            VALUE "OriginalFilename", "LightningRod.exe"
            VALUE "ProductName", "Thunderhead / Lightning Rod"
            VALUE "ProductVersion", TLR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
