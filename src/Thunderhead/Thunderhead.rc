#include <windows.h>
#include "resource.h"
#include "../common/Version.h"

IDI_APP ICON "Thunderhead.ico"

IDR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit", IDM_FILE_EXIT
    END
    POPUP "&Control"
    BEGIN
        POPUP "&Thunderhead Control"
        BEGIN
            MENUITEM "View Local Log", IDC_CMD_VIEW_LOCAL_LOG
            MENUITEM "Settings", IDC_CMD_SETTINGS
        END
        POPUP "&List Control"
        BEGIN
            MENUITEM "Check All (Ctrl-A)", IDC_CMD_CHECK_ALL
            MENUITEM "Check None (Ctrl-D)", IDC_CMD_CHECK_NONE
            MENUITEM "Check Outdated", IDC_CMD_CHECK_OUTDATED
        END
        POPUP "&Node Control"
        BEGIN
            MENUITEM "Open Client's Shared Folder", IDC_CMD_OPEN_SHARE
            MENUITEM "Copy Files or Folder to Client", IDC_CMD_COPY
            MENUITEM "Run Remote File", IDC_CMD_BATCH
            MENUITEM "Network Ping", IDC_CMD_NETPING
            MENUITEM "Send Wake On LAN Magic Packet", IDC_CMD_WOL
            MENUITEM "Set Client Date and Time", IDC_CMD_SET_TIME
            MENUITEM "Start TeamViewer", IDC_CMD_START_TV
            MENUITEM "Rename Node", IDC_CMD_RENAME
            MENUITEM "Shutdown Node", IDC_CMD_SHUTDOWN_NODE
            MENUITEM "Abort Shutdown", IDC_CMD_ABORT_SHUTDOWN
        END
        POPUP "Lightning&Rod Control"
        BEGIN
            MENUITEM "Update Checked", IDC_CMD_UPDATE
            MENUITEM "Display Message", IDC_CMD_MESSAGE
            MENUITEM "View Remote Log", IDC_CMD_VIEW_REMOTE_LOG
            MENUITEM "Lightning Rod Ping", IDC_CMD_PING
            MENUITEM "Remove Checked Offline Clients", IDC_CMD_REMOVE_OFFLINE
            MENUITEM "Set Relay Address", IDC_CMD_SET_RELAY
            MENUITEM "Restart LR", IDC_CMD_RESTART_LR
            MENUITEM "Exit LR", IDC_CMD_EXIT_LR
        END
        POPUP "&Audio Control"
        BEGIN
            MENUITEM "Mute Checked Clients", IDC_CMD_MUTE
            MENUITEM "Unmute Checked Clients", IDC_CMD_UNMUTE
            MENUITEM "Play Sound", IDC_CMD_SOUND
        END
        POPUP "Rende&r Control"
        BEGIN
            MENUITEM "Change Render Priority", IDC_CMD_PRIORITY
            MENUITEM "Stop Lightning", IDC_CMD_STOP
            MENUITEM "Run Lightning 3 (B7 && 7 Pro)", IDC_CMD_START71
            MENUITEM "Run Lightning 2 (B6.x)", IDC_CMD_START63
            MENUITEM "Run Lightning 1 (B5.x)", IDC_CMD_START50, GRAYED
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Thunderhead", IDM_HELP_ABOUT
    END
END

IDD_INTERVAL DIALOGEX 0, 0, 440, 380
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Nodes report every:", -1, 10, 12, 100, 10
    COMBOBOX        IDC_INTERVAL_COMBO, 114, 10, 90, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Dark Mode:", -1, 10, 40, 100, 10
    CONTROL         "", IDC_DARK_SWITCH, "Button", BS_OWNERDRAW | WS_TABSTOP, 114, 36, 30, 16
    LTEXT           "Off", IDC_DARK_STATE, 149, 40, 40, 10
    LTEXT           "Thunderhead Audio:", -1, 10, 66, 100, 10
    CONTROL         "", IDC_TH_AUDIO_SWITCH, "Button", BS_OWNERDRAW | WS_TABSTOP, 114, 62, 30, 16
    LTEXT           "On", IDC_TH_AUDIO_STATE, 149, 66, 40, 10
    LTEXT           "All Lightning Rods Audio:", -1, 10, 92, 100, 10
    CONTROL         "", IDC_LR_AUDIO_SWITCH, "Button", BS_OWNERDRAW | WS_TABSTOP, 114, 88, 30, 16
    LTEXT           "On", IDC_LR_AUDIO_STATE, 149, 92, 40, 10
    LTEXT           "Sound scheme:", -1, 10, 122, 52, 10
    AUTORADIOBUTTON "Default", IDC_SCHEME_DEFAULT, 66, 121, 46, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Custom", IDC_SCHEME_CUSTOM, 116, 121, 46, 10
    LTEXT           "", IDC_SCHEME_INFO, 172, 122, 258, 10
    CONTROL         "", IDC_SCHEME_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 10, 136, 420, 200
    PUSHBUTTON      "Browse...", IDC_SCHEME_BROWSE, 10, 342, 60, 14
    PUSHBUTTON      "Use Default", IDC_SCHEME_RESET, 74, 342, 60, 14
    PUSHBUTTON      "Play", IDC_SCHEME_PLAY, 138, 342, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 326, 360, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 380, 360, 50, 14
END

IDD_SOUND DIALOGEX 0, 0, 320, 230
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Play Sound"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_SOUND_INFO, 10, 8, 300, 18
    LISTBOX         IDC_SOUND_LIST, 10, 30, 300, 164, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON      "Play Here", IDC_SOUND_PLAY_HERE, 10, 206, 60, 14
    DEFPUSHBUTTON   "Play to Clients", IDC_SOUND_PLAY_CLIENTS, 176, 206, 74, 14
    PUSHBUTTON      "Close", IDCANCEL, 260, 206, 50, 14
END


// The radio buttons of the sound categories are created at run time from kSoundCategories,
// three columns of thirteen below the second line, Silent message last.
IDD_MESSAGE DIALOGEX 0, 0, 470, 330
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Display Message"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_MSG_INFO, 10, 8, 450, 10
    LTEXT           "Sound and title of the message (a sound category plays its file on the client and titles the message with its name):", -1, 10, 22, 450, 10
    LTEXT           "Message text:", -1, 10, 212, 100, 10
    EDITTEXT        IDC_MSG_TEXT, 10, 224, 450, 52, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Display:", -1, 10, 288, 40, 10
    CONTROL         "", IDC_MSG_TIMED_SWITCH, "Button", BS_OWNERDRAW | WS_TABSTOP, 52, 284, 30, 16
    LTEXT           "Until Dismissed", IDC_MSG_TIMED_STATE, 87, 288, 70, 10
    LTEXT           "Seconds:", -1, 162, 288, 34, 10
    EDITTEXT        IDC_MSG_SECONDS, 198, 286, 40, 13, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "Send", IDOK, 296, 308, 50, 14
    PUSHBUTTON      "Skip", IDCANCEL, 350, 308, 50, 14
    PUSHBUTTON      "Cancel All", IDABORT, 404, 308, 56, 14
END

IDD_RELAY DIALOGEX 0, 0, 270, 122
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Set Relay Address"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_RELAY_INFO, 10, 10, 250, 22
    LTEXT           "Act as SMB1 Relay:", -1, 10, 42, 84, 10
    CONTROL         "", IDC_RELAY_SWITCH, "Button", BS_OWNERDRAW | WS_TABSTOP, 98, 38, 30, 16
    LTEXT           "Off", IDC_RELAY_STATE, 133, 42, 40, 10
    LTEXT           "Destination IP:", -1, 10, 68, 84, 10
    EDITTEXT        IDC_RELAY_DEST, 98, 66, 100, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 102, 100, 50, 14
    PUSHBUTTON      "Skip", IDCANCEL, 156, 100, 50, 14
    PUSHBUTTON      "Cancel All", IDABORT, 210, 100, 50, 14
END

IDD_RENAME DIALOGEX 0, 0, 260, 96
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename node"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_RENAME_INFO, 10, 10, 240, 22
    LTEXT           "New name:", -1, 10, 38, 50, 10
    EDITTEXT        IDC_RENAME_NAME, 60, 36, 190, 13, ES_AUTOHSCROLL | ES_UPPERCASE
    AUTOCHECKBOX    "Reboot the node after a successful rename", IDC_RENAME_REBOOT, 10, 56, 240, 10
    DEFPUSHBUTTON   "Rename", IDOK, 92, 76, 50, 14
    PUSHBUTTON      "Skip", IDCANCEL, 146, 76, 50, 14
    PUSHBUTTON      "Stop", IDABORT, 200, 76, 50, 14
END

IDD_TEXTBOX DIALOGEX 0, 0, 440, 280
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT        IDC_TEXTBOX_TEXT, 10, 10, 420, 240, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 380, 258, 50, 14
END

IDD_BATCH DIALOGEX 0, 0, 440, 280
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Run Remote File"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_BATCH_INFO, 10, 8, 420, 10
    LTEXT           "File type:", -1, 10, 24, 40, 10
    AUTORADIOBUTTON "Batch (.bat)", IDC_BATCH_KIND_BAT, 52, 23, 60, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "PowerShell (.ps1)", IDC_BATCH_KIND_PS1, 118, 23, 80, 10
    AUTORADIOBUTTON "Executable (.exe)", IDC_BATCH_KIND_EXE, 204, 23, 80, 10
    LTEXT           "Executable in the client's shared folder (name or relative path):", IDC_BATCH_EXE_LABEL, 10, 40, 220, 10
    EDITTEXT        IDC_BATCH_EXE, 232, 38, 198, 13, ES_AUTOHSCROLL | WS_GROUP
    EDITTEXT        IDC_BATCH_TEXT, 10, 56, 420, 192, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse for file...", IDC_BATCH_BROWSE, 10, 256, 80, 14
    AUTOCHECKBOX    "Start maximized", IDC_BATCH_MAXIMIZED, 102, 258, 72, 10
    AUTOCHECKBOX    "Bring to front", IDC_BATCH_FRONT, 178, 258, 72, 10
    PUSHBUTTON      "Execute Remote File", IDC_BATCH_EXECUTE, 264, 256, 110, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 380, 256, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     TLR_VERSION_MAJOR, TLR_VERSION_MINOR, TLR_VERSION_PATCH, 0
PRODUCTVERSION  TLR_VERSION_MAJOR, TLR_VERSION_MINOR, TLR_VERSION_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Thunderhead render farm console"
            VALUE "FileVersion", TLR_VERSION_STRING
            VALUE "InternalName", "Thunderhead"
            VALUE "OriginalFilename", "Thunderhead.exe"
            VALUE "ProductName", "Thunderhead / Lightning Rod"
            VALUE "ProductVersion", TLR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
