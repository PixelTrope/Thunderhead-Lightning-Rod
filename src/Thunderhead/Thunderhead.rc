#include <windows.h>
#include "resource.h"
#include "../common/Version.h"

IDI_APP ICON "Thunderhead.ico"

IDR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit", IDM_FILE_EXIT
    END
    POPUP "&Node"
    BEGIN
        MENUITEM "&Remove checked offline nodes", IDM_NODE_REMOVE
    END
    POPUP "&Settings"
    BEGIN
        MENUITEM "&Report interval...", IDM_SETTINGS_INTERVAL
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Thunderhead", IDM_HELP_ABOUT
    END
END

IDD_INTERVAL DIALOGEX 0, 0, 200, 64
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Report interval"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Nodes report every:", -1, 10, 12, 80, 10
    COMBOBOX        IDC_INTERVAL_COMBO, 95, 10, 95, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 86, 42, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 140, 42, 50, 14
END

IDD_RENAME DIALOGEX 0, 0, 260, 96
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename node"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_RENAME_INFO, 10, 10, 240, 22
    LTEXT           "New name:", -1, 10, 38, 50, 10
    EDITTEXT        IDC_RENAME_NAME, 60, 36, 190, 13, ES_AUTOHSCROLL | ES_UPPERCASE
    AUTOCHECKBOX    "Reboot the node after a successful rename", IDC_RENAME_REBOOT, 10, 56, 240, 10
    DEFPUSHBUTTON   "Rename", IDOK, 92, 76, 50, 14
    PUSHBUTTON      "Skip", IDCANCEL, 146, 76, 50, 14
    PUSHBUTTON      "Stop", IDABORT, 200, 76, 50, 14
END

IDD_BATCH DIALOGEX 0, 0, 440, 280
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Run Remote Batch File"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_BATCH_INFO, 10, 8, 420, 10
    EDITTEXT        IDC_BATCH_TEXT, 10, 22, 420, 226, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse for file...", IDC_BATCH_BROWSE, 10, 256, 80, 14
    AUTOCHECKBOX    "Start maximized", IDC_BATCH_MAXIMIZED, 102, 258, 72, 10
    AUTOCHECKBOX    "Bring to front", IDC_BATCH_FRONT, 178, 258, 72, 10
    PUSHBUTTON      "Execute Remote Batch File", IDC_BATCH_EXECUTE, 264, 256, 110, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 380, 256, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     TLR_VERSION_MAJOR, TLR_VERSION_MINOR, TLR_VERSION_PATCH, 0
PRODUCTVERSION  TLR_VERSION_MAJOR, TLR_VERSION_MINOR, TLR_VERSION_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Thunderhead render farm console"
            VALUE "FileVersion", TLR_VERSION_STRING
            VALUE "InternalName", "Thunderhead"
            VALUE "OriginalFilename", "Thunderhead.exe"
            VALUE "ProductName", "Thunderhead / Lightning Rod"
            VALUE "ProductVersion", TLR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
